<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.wms.mapper.WmsInventoryRecordMapper">

    <resultMap type="WmsInventoryRecord" id="WmsInventoryRecordResult">
        <result property="id"    column="id"    />
        <result property="recordNo"    column="record_no"    />
        <result property="orderNo"    column="order_no"    />
        <result property="recordType"    column="record_type"    />
        <result property="warehouseId"    column="warehouse_id"    />
        <result property="locationId"    column="location_id"    />
        <result property="materialId"    column="material_id"    />
        <result property="changeQty"    column="change_qty"    />
        <result property="beforeQty"    column="before_qty"    />
        <result property="afterQty"    column="after_qty"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <insert id="insertWmsInventoryRecord" parameterType="WmsInventoryRecord" useGeneratedKeys="true" keyProperty="id">
        insert into wms_inventory_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recordNo != null and recordNo != ''">record_no,</if>
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="recordType != null and recordType != ''">record_type,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="locationId != null">location_id,</if>
            <if test="materialId != null">material_id,</if>
            <if test="changeQty != null">change_qty,</if>
            <if test="beforeQty != null">before_qty,</if>
            <if test="afterQty != null">after_qty,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="recordNo != null and recordNo != ''">#{recordNo},</if>
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="recordType != null and recordType != ''">#{recordType},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="locationId != null">#{locationId},</if>
            <if test="materialId != null">#{materialId},</if>
            <if test="changeQty != null">#{changeQty},</if>
            <if test="beforeQty != null">#{beforeQty},</if>
            <if test="afterQty != null">#{afterQty},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>
</mapper>
